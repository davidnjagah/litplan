          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/{{cityId}}/plans",
              "host": ["{{baseUrl}}"],
              "path": ["cities", "{{cityId}}", "plans"]
            },
            "description": "Get all plans for a city (respects user tier limits)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Plans array exists', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.plans).to.be.an('array');",
                  "  pm.expect(jsonData.userLimit).to.exist;",
                  "  pm.expect(jsonData.hasMore).to.exist;",
                  "});",
                  "",
                  "pm.test('Free user sees max 10 plans', function() {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.userLimit === 10) {",
                  "    pm.expect(jsonData.plans.length).to.be.at.most(10);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /cities/:cityId/plans (Weekend Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/{{cityId}}/plans?weekend=true",
              "host": ["{{baseUrl}}"],
              "path": ["cities", "{{cityId}}", "plans"],
              "query": [
                {
                  "key": "weekend",
                  "value": "true"
                }
              ]
            },
            "description": "Get weekend plans (should trigger paywall for free users)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Free user gets 403 for weekend plans', function() {",
                  "  // Assuming test user is free tier",
                  "  var statusCode = pm.response.code;",
                  "  pm.expect([200, 403]).to.include(statusCode);",
                  "  ",
                  "  if (statusCode === 403) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.code).to.eql('PAYWALL_LIMIT_REACHED');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
