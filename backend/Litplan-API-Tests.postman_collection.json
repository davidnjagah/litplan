    {
      "name": "2. Cities",
      "item": [
        {
          "name": "GET /cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities",
              "host": ["{{baseUrl}}"],
              "path": ["cities"]
            },
            "description": "Get list of all available cities"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains cities array', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.cities).to.be.an('array');",
                  "  pm.expect(jsonData.total).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Cities have required fields', function() {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.cities.length > 0) {",
                  "    var city = jsonData.cities[0];",
                  "    pm.expect(city.cityId).to.exist;",
                  "    pm.expect(city.name).to.exist;",
                  "    pm.expect(city.country).to.exist;",
                  "    pm.expect(city.displayAssets).to.exist;",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /cities (with search)",
          "request": {
            "method": "GET",
            "header": [],
