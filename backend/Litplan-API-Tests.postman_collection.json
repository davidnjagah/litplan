                  "pm.test('Filtered results match search query', function() {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.cities.length > 0) {",
                  "    var city = jsonData.cities[0];",
                  "    pm.expect(city.name.toLowerCase()).to.include('new');",
