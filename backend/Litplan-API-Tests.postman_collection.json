                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /user/me (Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["user", "me"]
            },
            "description": "Test unauthorized access - should return 401"
