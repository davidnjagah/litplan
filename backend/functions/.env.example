# Litplan Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ==============================================================================
# DATABASE CONFIGURATION (Sprint 6 - Supabase)
# ==============================================================================
# Supabase Postgres (production)
# Get your connection string from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Local PostgreSQL (for local development - optional)
# DATABASE_URL="postgresql://postgres:litplan_dev_password@localhost:5432/litplan_dev"

# ==============================================================================
# SUPABASE CONFIGURATION (Sprint 6)
# ==============================================================================
# Get these from: https://supabase.com/dashboard/project/[PROJECT-REF]/settings/api
#
# Project URL: Found in API Settings section
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Anon/Public Key: Found in API Settings section (safe to use in client-side code)
SUPABASE_ANON_KEY=your-anon-key

# Service Role Key: Found in API Settings section (use server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================================================
# CLERK AUTHENTICATION (Sprint 5 - DEPRECATED, migrating to Supabase)
# ==============================================================================
# Get these from: https://dashboard.clerk.com
#
# Publishable Key: Found in API Keys section (used by frontend)
# CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret Key: Found in API Keys section (used by backend for JWT verification)
# CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Webhook Secret: Create a webhook endpoint in Clerk Dashboard -> Webhooks
# Set the endpoint URL to: https://your-domain.com/webhooks/clerk
# Subscribe to events: user.created, user.updated, user.deleted, session.created, session.ended
# CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Apple Sign In Configuration
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# StoreKit 2 Configuration
APPLE_APP_STORE_SERVER_API_KEY=your-app-store-server-api-key
APPLE_BUNDLE_ID=com.yourcompany.litplan

# Apple In-App Purchase (Sprint 2, Day 8)
# Get your shared secret from: App Store Connect > My Apps > Your App > App Information > Shared Secret
# Required for: subscription/validate endpoint
# Must be exactly 32 characters
APPLE_SHARED_SECRET=your_32_character_shared_secret_here

# AI Service Configuration (for weekly plan generation)
# Sprint 4, Day 16 - Using Claude/Anthropic for AI plan generation
# Get your API key from: https://console.anthropic.com/
# Required for: weeklyPlanRefresh scheduled function
# Model used: claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative: OpenAI (not currently used, but supported)
# OPENAI_API_KEY=your-openai-api-key

# App Configuration
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_READ_PER_MINUTE=100
RATE_LIMIT_WRITE_PER_MINUTE=20

# Logging
LOG_LEVEL=info

# Weekly Plan Refresh Configuration (Sprint 4, Day 18)
# Dry-run mode: Set to 'true' to test weekly refresh without making changes
# Set to 'false' in production
WEEKLY_REFRESH_DRY_RUN=false

# Stripe Configuration (if using for payments instead of StoreKit)
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ==============================================================================
# FIREBASE FUNCTIONS CONFIGURATION
# ==============================================================================
# Alternative method: Use Firebase Functions config (recommended for production)
# Set config: firebase functions:config:set anthropic.api_key="YOUR_KEY"
# Set config: firebase functions:config:set apple.shared_secret="YOUR_SECRET"
# Set config: firebase functions:config:set refresh.dry_run="false"
# View config: firebase functions:config:get
# Download config for local testing: firebase functions:config:get > .runtimeconfig.json
