{
  "name": "litplan-backend-functions",
  "version": "1.0.0",
  "description": "Litplan Backend - Express API with Prisma + Supabase",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:vercel": "prisma generate && tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "start:prod": "node lib/server.js",
    "deploy": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:vercel": "vercel --prod",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:cities": "npm run build && node lib/scripts/seedCities.js",
    "seed:plans": "npm run build && node lib/scripts/seedPlans.js",
    "seed:users": "npm run build && node lib/scripts/seedUsers.js",
    "seed:groupFlows": "npm run build && node lib/scripts/seedGroupFlows.js",
    "dev": "npx ts-node src/server.ts",
    "dev:watch": "npx nodemon --exec 'npx ts-node' src/server.ts",
    "db:seed": "npx prisma db seed",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate",
    "setup:storage": "npx ts-node src/scripts/setupStorageBuckets.ts",
    "vercel:dev": "vercel dev",
    "postinstall": "prisma generate || true"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@clerk/backend": "^2.29.0",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@prisma/client": "^6.19.1",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.19.1",
    "svix": "^1.82.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase-functions-test": "^3.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vercel": "^32.0.0"
  },
  "private": true
}
