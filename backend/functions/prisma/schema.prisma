// Litplan Backend - Prisma Schema
// Sprint 6: Supabase Migration (formerly Clerk)
// Database: PostgreSQL (local) / Supabase (production)

generator client {
  provider        = "prisma-client-js"
  // Enable edge compatibility for Vercel serverless
  previewFeatures = ["driverAdapters"]
  // Binary targets for different platforms
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  // Connection pooling URL (PgBouncer on port 6543 for serverless)
  // This URL should use the connection pooler for better serverless performance
  url          = env("DATABASE_URL")
  // Direct connection URL for migrations (optional, port 5432)
  // Used by Prisma Migrate to execute schema changes
  directUrl    = env("DIRECT_DATABASE_URL")
  relationMode = "prisma" // Required for PlanetScale compatibility
}

// ==================== USER & AUTH ====================

model User {
  id              String    @id @default(cuid())
  supabaseUserId  String    @unique // Supabase Auth user ID
  email           String?   @unique
  displayName     String?
  imageUrl        String?
  appleRefreshToken String? // Stored Apple refresh token for token revocation (TN3194)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  subscription    Subscription?
  savedCities     SavedCity[]
  viewedCities    ViewedCity[]
  searchedCities  SearchedCity[]

  @@index([supabaseUserId])
  @@index([email])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  supabaseUserId        String             @unique // Supabase Auth user ID for easy lookup

  status                SubscriptionStatus @default(FREE)
  tier                  SubscriptionTier   @default(FREE)

  startDate             DateTime?
  expiryDate            DateTime?
  autoRenew             Boolean            @default(false)

  // StoreKit 2 fields
  transactionId         String?            // Current transaction ID from Apple
  originalTransactionId String?            // Original transaction ID (for renewals/restores)
  productId             String?            // Product identifier (litplan_pro_monthly, litplan_pro_yearly)
  purchaseDate          DateTime?          // When the purchase was made
  expiresDate           DateTime?          // When the current subscription period expires
  environment           String?            @default("production") // sandbox or production

  // Entitlements
  maxCitiesPerWeek      Int                @default(1)
  maxPlansPerCity       Int                @default(10)
  weekendAccess         Boolean            @default(false)
  groupPlansAccess      Boolean            @default(false)
  savedCitiesAccess     Boolean            @default(false)

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([supabaseUserId])
  @@index([transactionId])
  @@index([originalTransactionId])
  @@index([status])
}

enum SubscriptionStatus {
  FREE
  PRO
  TRIAL
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

enum SubscriptionTier {
  FREE
  PRO
}

// ==================== CITIES ====================

model City {
  id                 String      @id @default(cuid())
  cityId             String      @unique // Legacy ID for compatibility (e.g., 'nyc-001')
  name               String
  country            String
  countryCode        String
  rank               Int
  timezone           String

  // Display assets
  heroImage          String?
  cardImage          String?
  accentColor        String?     @default("#00D9FF")

  // Metadata
  totalPlansThisWeek Int         @default(0)
  featured           Boolean     @default(false)

  // Analytics (Sprint 14)
  searchCount        Int         @default(0) // Global search count for analytics

  // Coordinates
  latitude           Float
  longitude          Float

  lastUpdated        DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  plans              Plan[]
  groupFlows         GroupFlow[]
  savedByUsers       SavedCity[]
  viewedByUsers      ViewedCity[]
  searchedByUsers    SearchedCity[]

  @@index([rank])
  @@index([featured])
  @@index([name])
  @@index([searchCount])
}

// ==================== PLANS ====================

model Plan {
  id             String          @id @default(cuid())
  planId         String          @unique // Legacy ID (e.g., 'nyc-plan-001')
  cityId         String
  rank           Int

  title          String
  venueName      String
  description    String?
  category       String // e.g., 'Rooftop Bar', 'Live Music'
  type           PlanType

  // Images
  heroImage      String?
  thumbnailImage String?
  galleryImages  String[]        @default([])

  // Location
  address        String?
  neighborhood   String?
  googleMapsUrl  String?
  latitude       Float?
  longitude      Float?

  // Schedule
  date           String? // ISO date string
  startTime      String?
  endTime        String?
  isWeekend      Boolean         @default(false)
  weekday        String?

  // Weekly Plan System Fields (Sprint 14)
  weekNumber     Int?            // Week number (1-52)
  yearWeek       String?         // Format: "2026-W01"
  weekStartDate  DateTime?       // First day of the week

  // Event vs Permanent Venue (Sprint 14)
  isEvent        Boolean         @default(false) // True for weekly events, false for permanent venues
  eventDate      DateTime?       // Specific date if this is an event
  isRecurring    Boolean         @default(true)  // True for permanent venues

  // Change Detection (Sprint 14)
  contentHash    String?         // For detecting changes between refreshes
  sourceUrl      String?         // Source URL for the venue/event

  // AI Generation (Sprint 14)
  aiGenerated    Boolean         @default(false) // True if generated by AI agents

  // Pricing
  entryFee       Int? // In cents
  currency       String          @default("USD")
  priceRange     String? // e.g., '$$'
  freeEntry      Boolean         @default(true)

  // AI Tags
  genres         String[]        @default([])
  vibes          String[]        @default([])
  eventType      String?

  // Flags
  isIndividual   Boolean         @default(true)
  isGroup        Boolean         @default(false)
  isFeatured     Boolean         @default(false)

  // Reviews
  averageRating  Float?
  totalReviews   Int             @default(0)
  reviewSource   String?

  // Metadata
  source         String          @default("AI-generated")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  city           City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  flowSteps      GroupFlowStep[]

  @@index([cityId])
  @@index([rank])
  @@index([isWeekend])
  @@index([type])
  @@index([yearWeek, cityId])
  @@index([isEvent])
}

enum PlanType {
  BAR
  CLUB
  EVENT
  RESTAURANT
}

// ==================== GROUP FLOWS ====================

model GroupFlow {
  id            String          @id @default(cuid())
  flowId        String          @unique // Legacy ID (e.g., 'nyc-flow-001')
  cityId        String
  rank          Int

  title         String
  description   String?

  // Duration
  totalHours    Float
  startTime     String?
  endTime       String?

  // Pricing
  totalEstimate Int? // In cents
  currency      String          @default("USD")

  // Flags
  isWeekend     Boolean         @default(false)
  proOnly       Boolean         @default(true)
  aiGenerated   Boolean         @default(true)

  // Event vs Permanent Group Flow (Sprint 14)
  isTemporary   Boolean         @default(false) // True for event-based flows that expire
  eventDate     DateTime?       // Date of the event (for temporary flows)
  expiresAt     DateTime?       // When this group flow should be removed
  theme         String?         // Theme category (rooftop, comedy, jazz, boat-party, etc.)

  // Content tracking for updates
  contentHash   String?         // For detecting when content needs updating
  lastRefreshed DateTime?       // When AI last reviewed this flow

  // Difficulty
  difficulty    String          @default("moderate") // easy, moderate, intense

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  city          City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  steps         GroupFlowStep[]

  @@index([cityId])
  @@index([rank])
  @@index([isTemporary])
  @@index([expiresAt])
  @@index([theme])
}

model GroupFlowStep {
  id         String    @id @default(cuid())
  flowId     String
  planId     String
  stepNumber Int

  title      String
  venueName  String
  duration   Int // In minutes
  thumbnail  String?

  // Relations
  flow       GroupFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([flowId, stepNumber])
  @@index([flowId])
  @@index([planId])
}

// ==================== USER ACTIVITY ====================
// Sprint 9: Removed UserActivity model and ActivityType enum
// Activity tracking is now done through ViewedCity and SavedCity tables only

model SavedCity {
  id      String   @id @default(cuid())
  userId  String
  cityId  String

  notes   String?
  savedAt DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([userId])
  @@index([cityId])
}

model ViewedCity {
  id           String   @id @default(cuid())
  userId       String
  cityId       String

  viewedAt     DateTime @default(now())
  lastViewedAt DateTime @default(now()) // Updates on each view for efficient sorting
  viewCount    Int      @default(1)

  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@index([userId])
  @@index([viewedAt])
  @@index([userId, lastViewedAt]) // Composite index for efficient paginated user history queries
}

model SearchedCity {
  id          String   @id @default(cuid())
  userId      String
  cityId      String
  searchQuery String   // The search term used

  searchedAt  DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([searchedAt])
  @@index([userId, searchedAt]) // Composite index for efficient user history queries
}

// ==================== APP CONFIG ====================

model AppConfig {
  id                String   @id @default("app")
  currentWeek       String // e.g., '2026-W01'
  weekStartDate     DateTime
  weekEndDate       DateTime

  // Free tier config (Sprint 14: increased from 1 to 10)
  freeMaxCities     Int      @default(10) // 10 cities per week for free users
  freeMaxPlans      Int      @default(10)
  freeWeekendAccess Boolean  @default(false)

  // Pro tier config
  proMaxCities      Int      @default(100)
  proMaxPlans       Int      @default(50)
  proWeekendAccess  Boolean  @default(true)

  updatedAt         DateTime @updatedAt
}

// ==================== WEEKLY REFRESH LOG (Sprint 14) ====================

model WeeklyRefreshLog {
  id                  String    @id @default(cuid())
  yearWeek            String    // e.g., '2026-W01'

  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  status              RefreshStatus @default(RUNNING)

  // Statistics
  citiesProcessed     Int       @default(0)
  plansCreated        Int       @default(0)
  plansUpdated        Int       @default(0)
  plansUnchanged      Int       @default(0)
  groupFlowsGenerated Int       @default(0)

  // Error tracking
  errors              Json?     // Array of error messages

  @@index([yearWeek])
  @@index([status])
  @@index([startedAt])
}

enum RefreshStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}
