# Litplan Backend - Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control

# ==============================================================================
# VERCEL DEPLOYMENT CONFIGURATION
# ==============================================================================
# These variables should be configured in Vercel Dashboard > Project Settings > Environment Variables
# Use "Production" environment for production deployments
# Use "Preview" environment for preview/staging deployments

# ==============================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ==============================================================================
# Primary connection URL with connection pooling (PgBouncer)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Connection pooling" mode connection string (port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations only - not used in serverless runtime)
# Use the direct connection string (port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Get these from: https://supabase.com/dashboard/project/[PROJECT-REF]/settings/api

# Project URL: Found in API Settings section
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Anon/Public Key: Safe to use in client-side code, respects Row Level Security
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Service Role Key: Use server-side only, bypasses Row Level Security
# WARNING: Keep this secret - never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# JWT Secret: For verifying Supabase Auth tokens (optional, derived from service role key)
SUPABASE_JWT_SECRET=your-jwt-secret

# ==============================================================================
# AI SERVICE CONFIGURATION (Anthropic Claude)
# ==============================================================================
# Get your API key from: https://console.anthropic.com/
# Used for AI-powered plan generation and recommendations
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=production

# API Version (for versioned endpoints)
API_VERSION=v2

# CORS Configuration
# Comma-separated list of allowed origins
# Include your production domains and any preview domains
CORS_ORIGIN=https://litplanz.com,https://www.litplanz.com,https://litplanai.vercel.app

# Request logging (set to 'true' for debugging)
LOG_REQUESTS=false

# ==============================================================================
# OPTIONAL: RATE LIMITING
# ==============================================================================
# Adjust based on your traffic patterns
RATE_LIMIT_READ_PER_MINUTE=100
RATE_LIMIT_WRITE_PER_MINUTE=20

# ==============================================================================
# OPTIONAL: FIREBASE CONFIGURATION (if using Firebase services)
# ==============================================================================
# Only needed if you're using Firebase for additional services
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ==============================================================================
# OPTIONAL: APPLE STOREKIT CONFIGURATION (for in-app purchases)
# ==============================================================================
# Get your shared secret from: App Store Connect > My Apps > Your App > App Information
# APPLE_SHARED_SECRET=your_32_character_shared_secret_here
# APPLE_BUNDLE_ID=com.yourcompany.litplan

# ==============================================================================
# VERCEL-SPECIFIC VARIABLES (automatically set by Vercel)
# ==============================================================================
# These are automatically injected by Vercel, no need to set manually:
# - VERCEL_ENV (production, preview, development)
# - VERCEL_URL (deployment URL)
# - VERCEL_REGION (deployment region, e.g., iad1)

# ==============================================================================
# SETTING UP ENVIRONMENT VARIABLES IN VERCEL
# ==============================================================================
# 1. Go to your Vercel Dashboard
# 2. Select your project
# 3. Go to Settings > Environment Variables
# 4. Add each variable:
#    - DATABASE_URL (Production, Preview)
#    - DIRECT_DATABASE_URL (Production, Preview)
#    - SUPABASE_URL (Production, Preview)
#    - SUPABASE_ANON_KEY (Production, Preview)
#    - SUPABASE_SERVICE_ROLE_KEY (Production, Preview) - Mark as Secret
#    - ANTHROPIC_API_KEY (Production) - Mark as Secret
#    - NODE_ENV=production (Production only)
#
# TIP: Use different Supabase projects for Production vs Preview environments
